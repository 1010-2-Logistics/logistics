# =============================================================================
# .env.example — 실제 값을 채워 .env 로 복사해서 사용 (.env 는 gitignore 대상)
# =============================================================================
#
# docker-compose.data.yml / docker-compose.app.yml 이 참조한다.
#
# 로컬 전체 검증
#   docker compose -f docker-compose.data.yml -f docker-compose.app.yml up
#
# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL 컨테이너 초기화 (docker-compose.data.yml)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=logistics

# ─────────────────────────────────────────────────────────────────────────────
# 애플리케이션이 접속할 대상 (docker-compose.app.yml)
#
# 로컬   : 컨테이너 이름을 그대로 쓴다      → postgres / redis / rabbitmq
# App EC2: Data EC2 의 프라이빗 IP 를 넣는다 → 10.0.2.x
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=redis

RABBITMQ_HOST=rabbitmq
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ─────────────────────────────────────────────────────────────────────────────
# 인증
# ─────────────────────────────────────────────────────────────────────────────
# HMAC 대칭키. user-service 가 서명하고 Gateway 가 검증하므로 값이 같아야 한다.
# 최소 32바이트. 예: openssl rand -base64 48
JWT_SECRET=

# 최초 MASTER 계정 부트스트랩.
# 일반 회원가입으로는 MASTER 를 만들 수 없어(SignupService) 이 값으로만 생성된다.
MASTER_USERNAME=
MASTER_PASSWORD=
MASTER_SLACK_ID=

# ─────────────────────────────────────────────────────────────────────────────
# 외부 연동
# ─────────────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────────────
# 이미지 (Phase 2 이후. 미설정이면 로컬 빌드 이미지를 쓴다)
# ─────────────────────────────────────────────────────────────────────────────
# IMAGE_REGISTRY=<account>.dkr.ecr.ap-northeast-2.amazonaws.com/logistics
# IMAGE_TAG=latest
